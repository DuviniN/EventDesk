# Example environment variables for EventDesk backend
# Copy this file to `.env` for local development.
# On Vercel: set these in Project Settings → Environment Variables.

# --- Database ---

# Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-strong-random
JWT_REFRESH_SECRET=replace-with-strong-random
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# --- CORS ---
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# --- Security/Hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Tickets/QR ---
# If empty, QR signing falls back to JWT_ACCESS_SECRET
QR_SECRET=

# --- Email (optional) ---
EMAIL_USER=
EMAIL_PASS=

# --- Server ---
PORT=5000
